<?xml version="1.0" encoding="UTF-8"?>
<!-- Local mode on the Mac. Replace YOU with your user name, then:
       cp dev.sandhill.sandhilld.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.sandhill.sandhilld.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.sandhill.sandhilld</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOU/.local/bin/sandhilld</string>
        <string>serve</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <!-- Kernels must survive a daemon restart. -->
    <key>AbandonProcessGroup</key>
    <true/>
</dict>
</plist>
